{
  "name": "@yz-social/kdht",
  "version": "0.1.49",
  "description": "Pure Kademlia base, for testing variations.",
  "exports": {
    ".": "./index.js",
    "./router": "./scripts/router.js",
    "./portal": "./scripts/node.js"
  },
  "type": "module",
  "scripts": {
    "start": "npm stop; npm run shared",
    "stop": "pkill kdht",
    "local": "node scripts/portal.js",
    "ki1r0y": "node scripts/portal.js  --externalBaseURL https://ki1r0y.com/kdht",
    "shared": "node scripts/portal.js  --externalBaseURL https://ki1r0y.com/kdht",
    "background": "npm stop; (npm start 1>server.log 2>&1 &); sleep 1",
    "withoutExternal": "node scripts/portal.js",
    "bots": "node scripts/bots.js",
    "thrashbots": "node scripts/bots.js --thrash",
    "testWebrtc": "npm stop; npx jasmine spec/testWebrtc.js",
    "test": "npx jasmine && npm run testWebrtc && echo '-- SUCCESS --' || echo '**** FAIL ****'"
  },
  "dependencies": {
    "@yz-social/webrtc": "^0.1.10",
    "node-turn": "^0.0.6",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "log4js": "^6.9.1"
  },
  "devDependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jasmine": "^5.12.0",
    "morgan": "^1.10.1",
    "yargs": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YZ-social/kdht.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
